<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lucida.AboutSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Lucida"
    Background="Transparent"
    Loaded="Page_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Uid="Prefs_AboutHeader" Style="{StaticResource SettingsPageHeaderTextStyle}" AutomationProperties.HeadingLevel="Level1" />
        <ScrollViewer Grid.Row="1" Style="{StaticResource SettingsPageScrollViewerStyle}">
            <StackPanel Style="{StaticResource SettingsPageContentStyle}">
                <local:SettingsCard x:Uid="Prefs_AboutVersion">
                    <TextBlock x:Name="VersionText" Style="{StaticResource BodyTextBlockStyle}" />
                </local:SettingsCard>
                <local:SettingsCard x:Uid="Prefs_AboutNotices">
                    <StackPanel Spacing="12">
                        <Button x:Name="NoticesButton" x:Uid="Prefs_AboutViewNotices" HorizontalAlignment="Left" Click="NoticesButton_Click" />
                        <TextBox x:Name="NoticesText" Visibility="Collapsed" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                 FontFamily="Consolas" FontSize="12" MinHeight="240" MaxHeight="480" />
                    </StackPanel>
                </local:SettingsCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
